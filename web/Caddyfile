# Serves the built SPA and routes API traffic inside the Docker network.
# TLS is terminated on VUB's F5 load balancer, so this listens on plain HTTP.
{
	admin off
	auto_https off
	servers {
		# Trust X-Forwarded-* headers from the F5 (private address space)
		trusted_proxies static private_ranges
		# Slow clients can't hold connections open indefinitely: headers must
		# arrive within 10s, a whole body (up to 52 MB) within 5 minutes.
		timeouts {
			read_header 10s
			read_body 5m
		}
	}
}

:80 {
	encode gzip

	handle /api/* {
		# Import accepts xlsx files up to 50 MB (+ multipart overhead)
		request_body {
			max_size 52MB
		}
		reverse_proxy fastapi:8000
	}

	# Code sign-in: GoTrue checks emailed one-time codes on POST /auth/v1/verify
	# (email + short code, guessable by brute force). The app only uses the
	# emailed links, which are GET /auth/v1/verify with a long token, so refuse
	# the POST form outright.
	@otp_code_verify {
		method POST
		path /auth/v1/verify
	}
	handle @otp_code_verify {
		header Content-Type application/json
		respond `{"error":"code_sign_in_disabled","msg":"Sign in with the link in the email instead."}` 403
	}

	# Only the versioned API prefixes the app uses. The gateway sends any path it
	# doesn't route (e.g. /auth/callback) to Supabase Studio's basic-auth login,
	# so broader matchers like /auth/* would expose Studio publicly.
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/*
	handle @supabase {
		# Auth, PostgREST, Storage and Edge Function calls from the app are small
		request_body {
			max_size 10MB
		}
		reverse_proxy kong:8000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
