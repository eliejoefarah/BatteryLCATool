# Values to set in the VM's stack .env (/data/battery-lci/stack/.env).
#
# 1. cp .env.example .env && chmod 600 .env
# 2. sh utils/generate-keys.sh --update-env
#      writes fresh JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD,
#      DASHBOARD_PASSWORD, SECRET_KEY_BASE, VAULT_ENC_KEY, REALTIME_DB_ENC_KEY,
#      PG_META_CRYPTO_KEY, LOGFLARE_*, MINIO_ROOT_PASSWORD. Don't edit those by hand.
# 3. Change or add the keys below. Everything else keeps Supabase's default.
#    Generate the app secrets with:  openssl rand -hex 32

# ── Supabase keys to CHANGE ──────────────────────────────────────────────────
# (ship.sh appends :docker-compose.battery-lci.yml to COMPOSE_FILE itself)
DASHBOARD_USERNAME=admin
POOLER_TENANT_ID=battery-lci

SITE_URL=https://battery-lci.vub.be
ADDITIONAL_REDIRECT_URLS=https://battery-lci.vub.be/auth/callback
SUPABASE_PUBLIC_URL=https://battery-lci.vub.be
# Note the /auth/v1 suffix: GoTrue uses this as its own public base URL
API_EXTERNAL_URL=https://battery-lci.vub.be/auth/v1

# Invite-only app. Users are created by invite_user (admin API), which works
# with public sign-up disabled. Leaving sign-up open would let anyone with the
# public anon key create an account, and on_user_created would then give it a
# 'manufacturer' row. Test an invite after the first deploy to confirm.
DISABLE_SIGNUP=true
ENABLE_PHONE_SIGNUP=false

# VUB SMTP relay (pending from IT)
SMTP_ADMIN_EMAIL=<sender address, e.g. no-reply@vub.be>
SMTP_HOST=<relay host>
SMTP_PORT=587
SMTP_USER=<user or empty>
SMTP_PASS=<password or empty>
SMTP_SENDER_NAME=Battery LCA Tool

# Our functions verify callers themselves (user JWT via auth.getUser, or the
# webhook secret for on_user_created), so the gateway must not reject them.
FUNCTIONS_VERIFY_JWT=false

# Not used (AI features in Studio are a third-party call)
OPENAI_API_KEY=

# ── App keys to ADD ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=<openssl rand -hex 32>
INTERNAL_API_SECRET=<openssl rand -hex 32>
WEB_HTTP_PORT=80
